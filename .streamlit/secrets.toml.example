# Copy to .streamlit/secrets.toml (gitignored) to run the app locally, and
# paste the same content into the app's Secret File (secrets.toml) on
# Render. See "Streamlit app" in README.md for where each value
# comes from.

[database]
# The read-only app_reader login (db/app_reader.sql), never the owner
# login in .env.
host = "aws-1-us-east-2.pooler.supabase.com"
port = 6543
user = "app_reader.YOUR_PROJECT_REF"
password = "THE_APP_READER_PASSWORD"

[auth]
# Locally: http://localhost:8501/oauth2callback
# Deployed: https://gowanus-dredgers.onrender.com/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string; signs the login cookie.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "A_LONG_RANDOM_STRING"
# From the Google Cloud OAuth client (Credentials > OAuth 2.0 Client IDs).
client_id = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
